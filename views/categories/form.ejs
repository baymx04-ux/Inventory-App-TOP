<%- include('../partials/header') %>
<h1><%= isEdit ? 'Edit category' : 'New category' %></h1>
<%- include('../partials/errors') %>
<form method="POST" action="<%= action %>" class="form">
  <label for="name">Name</label>
  <input id="name" name="name" type="text" maxlength="100" required value="<%= category.name || '' %>">

  <label for="description">Description</label>
  <textarea id="description" name="description" rows="4"><%= category.description || '' %></textarea>

  <% if (isEdit) { %>
    <label for="adminPassword">Admin password</label>
    <input id="adminPassword" name="adminPassword" type="password" required>
  <% } %>

  <div class="actions">
    <button type="submit" class="btn">Save</button>
    <a class="btn btn-secondary" href="<%= isEdit ? '/categories/' + category.id : '/' %>">Cancel</a>
  </div>
</form>
<%- include('../partials/footer') %>
